{
  "expo": {
    "name": "Findally",
    "slug": "reunitd-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "privacy": "public",
    "privacyPolicyUrl": "https://findally.us/privacy",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "us.findally.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Findally uses location to provide scan geolocation data.",
        "NSCameraUsageDescription": "Findally uses the camera to read the activation or pack code printed on the card that comes with your patches.",
        "NSPhotoLibraryUsageDescription": "Findally uses your photo library to add a child's photo to their profile.",
        "NSFaceIDUsageDescription": "Findally uses Face ID to unlock the app, so only you can open your family's details.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "package": "us.findally.mobile",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563eb",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Findally Alert"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Findally uses your photo library to add a child's photo to their profile.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7fddb323-866d-4604-83c3-e6f8ccc762a1"
      }
    },
    "owner": "robert741"
  }
}
